<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PSFortiCNAPP.ModuleInfo</Name>
      <ViewSelectedBy>
        <TypeName>PSFortiCNAPP.ModuleInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Version</Label></TableColumnHeader>
          <TableColumnHeader><Label>Minimum PowerShell</Label></TableColumnHeader>
          <TableColumnHeader><Label>Distribution</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Version</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>MinimumPowerShellVersion</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Distribution</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSFortiCNAPP.EnvironmentReadiness</Name>
      <ViewSelectedBy>
        <TypeName>PSFortiCNAPP.EnvironmentReadiness</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Ready</Label></TableColumnHeader>
          <TableColumnHeader><Label>Complete</Label></TableColumnHeader>
          <TableColumnHeader><Label>OS</Label></TableColumnHeader>
          <TableColumnHeader><Label>PowerShell</Label></TableColumnHeader>
          <TableColumnHeader><Label>Passed</Label></TableColumnHeader>
          <TableColumnHeader><Label>Warnings</Label></TableColumnHeader>
          <TableColumnHeader><Label>Failed</Label></TableColumnHeader>
          <TableColumnHeader><Label>Workspace</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Ready</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Complete</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OperatingSystem</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>PowerShellVersion</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>PassCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WarningCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>FailCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WorkspacePath</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSFortiCNAPP.EvidenceRecord</Name>
      <ViewSelectedBy>
        <TypeName>PSFortiCNAPP.EvidenceRecord</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Severity</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Evidence</Label></TableColumnHeader>
          <TableColumnHeader><Label>Domain</Label></TableColumnHeader>
          <TableColumnHeader><Label>Cloud</Label></TableColumnHeader>
          <TableColumnHeader><Label>Resource</Label></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Severity</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EvidenceState</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Domain</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CloudProvider</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ResourceId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Title</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSFortiCNAPP.HttpExchange</Name>
      <ViewSelectedBy>
        <TypeName>PSFortiCNAPP.HttpExchange</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Exchange</Label></TableColumnHeader>
          <TableColumnHeader><Label>Method</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Family</Label></TableColumnHeader>
          <TableColumnHeader><Label>Body</Label></TableColumnHeader>
          <TableColumnHeader><Label>Contract</Label></TableColumnHeader>
          <TableColumnHeader><Label>Duration ms</Label></TableColumnHeader>
          <TableColumnHeader><Label>URI</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ExchangeId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Method</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>StatusCode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>StatusFamily</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>BodyState</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ContractState</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DurationMilliseconds</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RequestUri</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PSFortiCNAPP.SyntheticHttpContractSummary</Name>
      <ViewSelectedBy>
        <TypeName>PSFortiCNAPP.SyntheticHttpContractSummary</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Classification</Label></TableColumnHeader>
          <TableColumnHeader><Label>Exchanges</Label></TableColumnHeader>
          <TableColumnHeader><Label>HTTP Success</Label></TableColumnHeader>
          <TableColumnHeader><Label>Valid</Label></TableColumnHeader>
          <TableColumnHeader><Label>Warnings</Label></TableColumnHeader>
          <TableColumnHeader><Label>Invalid</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>DataClassification</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ExchangeCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SuccessCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ValidContractCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WarningContractCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>InvalidContractCount</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
